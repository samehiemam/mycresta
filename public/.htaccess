# Cresta Marine — static SPA on Apache / LiteSpeed (Hostinger)

# Prerendering gives /fleet and /fleet/kumbra-43 real directories on disk, and
# mod_dir answers a directory request with a 301 to the trailing-slash form
# before the rewrite below is ever consulted. That would redirect every
# indexed URL to a second address that disagrees with its own canonical tag.
# Turning DirectorySlash off leaves the path to the rewrite; -Indexes then
# makes sure no directory can be listed as a result.
<IfModule mod_dir.c>
  DirectorySlash Off
  DirectoryIndex index.html
</IfModule>
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical hostname. Both www and the apex answered on 443, so the whole
  # site existed twice as far as a search engine was concerned, splitting the
  # ranking signals between two addresses that were never linked to each other.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Renamed pages. These must come before the prerender rule below: a deploy
  # here overwrites but never deletes, so the old directory is still sitting on
  # disk and would otherwise be served in preference to the redirect.
  RewriteRule ^services/?$ /ownership [R=301,L]

  # Serve real files as-is (assets, images, submit.php, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # A prerendered route -> its index.html. Done explicitly rather than by
  # letting Apache find the DirectoryIndex, because that path answers /fleet
  # with a 301 to /fleet/ and every indexed URL would carry a needless hop.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # The home page, explicitly. The prerender rule above cannot match it: in a
  # per-directory context "/" is the empty string, and its pattern needs at
  # least one character. It used to be caught by the blanket fallback that the
  # 404 below replaces, so without this line the site's front page is the one
  # address that stops working.
  RewriteRule ^$ /index.html [L]

  # The portal is a client-side app and its paths are not prerendered, so they
  # reach here and must still serve the entry.
  RewriteCond %{REQUEST_URI} ^/portal(/|$)
  RewriteRule ^ /index.html [L]

  # Everything left over was never a page on this site.
  #
  # It used to be served the entry with a 200, which is a soft 404: the address
  # answers, so a search engine has no reason to drop it. An earlier version of
  # this site had /contact, /platform and others, and Google was still offering
  # them as sitelinks — each one landing on a page that is not what the link
  # said. They cannot leave the index until the server admits they are gone.
  #
  # The body is still the app, so a person who follows a stale link sees the
  # site's own not-found page rather than a bare server error. Only the status
  # changes, and the status is the part a crawler reads.
  ErrorDocument 404 /index.html
  RewriteRule ^ - [R=404,L]
</IfModule>

# The server has no mapping for these, so it labelled them text/plain and left
# browsers to sniff the format. That works until something declines to guess.
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType image/svg+xml .svg
  AddType font/woff2  .woff2
</IfModule>

# Long-cache fingerprinted build assets.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|avif|webp|svg|mp4)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Never cache the HTML entry so new deploys show up immediately.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Baseline security headers. None of these fix a hole — the portal already
  # refuses config.php, the SQL and the library — but they close the classes of
  # attack that need the browser's cooperation, and they are what a hosting
  # vulnerability scan looks for.

  # The portal signs people in, so the session cookie must never be replayable
  # from inside somebody else's frame.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stops a browser from guessing that an uploaded file is really something
  # executable. Matters because the vault will accept customer documents.
  Header always set X-Content-Type-Options "nosniff"

  # Full URLs leak: a shared configuration or a password-reset link would
  # otherwise travel in the Referer to any site a customer clicks through to.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nothing here uses a camera, a microphone or a location, so nothing may.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
