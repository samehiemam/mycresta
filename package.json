{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.static.ts",
    "dev": "vite --config vite.config.static.ts",
    "preview": "vite preview --config vite.config.static.ts",
    "build:static": "vite build --config vite.config.static.ts",
    "dev:static": "vite --config vite.config.static.ts",
    "preview:static": "vite preview --config vite.config.static.ts",
    "build:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "start:cloudflare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:cloudflare && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "4.2.1",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "wrangler": "4.120.0"
  },
  "//overrides": [
    "Patched versions of transitive build-tool dependencies. Every one of these",
    "reaches us through tooling (eslint, vite, wrangler, drizzle-kit, next) and",
    "none of it ships to the browser or runs on the server — the deploy is static",
    "HTML/CSS/JS plus PHP. They are pinned here anyway so the dependency scanner",
    "reports clean and a future direct upgrade cannot quietly reintroduce them.",
    "Drop an entry once the package that depends on it ships the fix itself."
  ],
  "overrides": {
    "@babel/core": "^7.29.6",
    "brace-expansion@^1": "^1.1.18",
    "brace-expansion@^5": "^5.0.9",
    "esbuild": "^0.28.1",
    "fast-uri@^3": "^3.1.5",
    "js-yaml@^4": "^4.3.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "ws": "^8.21.3"
  },
  "type": "module"
}
